# Python, editors, dependencies, and machine-local credentials.
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
.venv/
venv/
env/
ENV/
.conda/
.vscode/
.idea/
*.swp
*.swo
.env
.env.*
!.env.example
.ssh/
*.pem
*.key
id_rsa*
id_ed25519*

# Raw acquisition and derived arrays are backed up outside Git.
*.tdms
*.tdms_index
*.npy
*.npz
*.pkl
*.pickle
*.h5
*.hdf5
*.parquet
*.joblib
*.wav
*.m4a
*.mp3
*.mp4
*.mov
*.avi

# COMSOL solutions, Java binaries, and compilation products.
*.mph
*.mph.*
*.class
*.class.*
*.recovery
*.status
*.lock
build/
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.synctex.gz
*.toc
*.log
*.out

# Presentation/Word originals and inspection renders remain local.
*.pptx
*.ppt
*.docx
*.doc
*.inspect.ndjson
*.validation.json
~$*
/deliverables/*
!/deliverables/README.md

# Local dependencies, temporary outputs, and full relocation manifests.
/local/
/.agents/

# Historical material copies are indexed, not uploaded twice.
/archive/material_snapshot_20260927/*
!/archive/material_snapshot_20260927/资料导航.md
/archive/snapshots/V1_candidate_*/
/archive/legacy_packages/
/archive/scratch_build/

# Earlier bulk output: compact artifacts only (see its own .gitignore).
/analysis/legacy_pipeline/*
!/analysis/legacy_pipeline/README.md
!/analysis/legacy_pipeline/.gitignore
!/analysis/legacy_pipeline/*/

# Research outputs: keep reports/tables/figures, not smoke runs or raw caches.
**/cache/
**/media/
**/audio/
**/frames/
**/extracted_frames/
**/COMPLETE
/experiments/**/raw/
/analysis/**/raw/
/analysis/**/preservation/
